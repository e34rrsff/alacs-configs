<?xml version="1.0" encoding="utf-8"?>
<image schemaversion="7.4" name="alacs-fedora-workstation">
	<description type="system">
		<author>ALACS</author>
		<contact>alacs@localhost</contact>
		<specification>Fedora Workstation raw disk image</specification>
	</description>

	<!-- Pull in shared preferences, repos, core packages, users -->
	<include from="this://../common.xml"/>

	<!-- Image type: raw OEM disk with grub2, EFI + ext4 root -->
	<preferences arch="x86_64">
		<type image="oem"
		      primary="true"
		      filesystem="ext4"
		      firmware="efi"
		      efipartsize="512"
		      kernelcmdline="rhgb quiet">
		      	<bootloader name="grub2" timeout="5" bls="true"/>
        		<oemconfig>
        			<oem-resize>true</oem-resize>
        		</oemconfig>
        		<size unit="G">8</size>
		</type>
	</preferences>

	<!-- Workstation image packages -->
	<packages type="image">
		<namedCollection name="standard"/>

		<!-- Fedora release -->
		<package name="fedora-release-workstation"/>

		<!-- Kernel -->
		<package name="kernel-core"/>
		<package name="kernel-modules"/>

		<!-- Bootloader -->
		<package name="grub2-efi-x64" arch="x86_64"/>
		<package name="grub2-efi-x64-modules" arch="x86_64"/>
		<package name="grub2-pc" arch="x86_64"/>
		<package name="grub2-pc-modules" arch="x86_64"/>
		<package name="shim-signed-x64"/>

		<!-- Initrd -->
		<package name="dracut-kiwi-oem-repart"/>
		<package name="dracut-kiwi-oem-dump"/>

		<!-- systemd extras -->
		<package name="systemd-oomd-defaults"/>

		<!-- GNOME Desktop -->
		<namedCollection name="workstation-product-environment"/>
		<namedCollection name="fonts"/>
		<namedCollection name="multimedia"/>
		<namedCollection name="networkmanager-submodules"/>
		<namedCollection name="printing"/>
		<package name="mediawriter"/>

		<!-- Firmware -->
		<package name="linux-firmware"/>

		<!-- Filesystem tools -->
		<package name="e2fsprogs"/>
		<package name="dosfstools"/>

		<!-- Locale support -->
		<package name="glibc-all-langpacks"/>

		<!-- Basic utilities -->
		<package name="vim-minimal"/>
		<package name="sudo"/>
	</packages>
</image>
